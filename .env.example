# Copia este archivo como .env.local si necesitas cambiar valores por defecto.

# Ruta base cuando el sitio se publica en un subdirectorio (GitHub Pages: /nombre-del-repositorio).
# Déjalo vacío para dominio propio, Netlify, Cloudflare Pages o Vercel.
NEXT_PUBLIC_BASE_PATH=

# URL pública final del sitio (sitemap, Open Graph, canonical). Sin barra al final.
NEXT_PUBLIC_SITE_URL=https://example.github.io/moquegua-resultados-erm-2026

# --- Modo A (CLI scripts/fetch-onpe.ts) ---
# Base de los servicios públicos que usa la plataforma de ONPE.
ONPE_BASE_URL=https://resultadoelectoral.onpe.gob.pe/presentacion-backend
# Pausa mínima entre solicitudes (ms) y reintentos con backoff exponencial.
ONPE_MIN_INTERVAL_MS=1500
ONPE_MAX_RETRIES=4
# Caché local de respuestas (segundos). 0 desactiva la caché.
ONPE_CACHE_TTL_SECONDS=300
