{
  "name": "moquegua-resultados-erm-2026",
  "version": "1.0.0",
  "private": true,
  "description": "Visualización independiente de los resultados públicos de las Elecciones Regionales y Municipales 2026 en Moquegua (fuente: ONPE).",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run data:check && tsx scripts/prepare-public-data.ts && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "data:fetch": "tsx scripts/fetch-onpe.ts",
    "data:import": "tsx scripts/import-manual.ts",
    "data:build": "tsx scripts/build-dataset.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:check": "tsx scripts/validate-data.ts --quiet",
    "data:logos": "tsx scripts/fetch-logos.ts",
    "data:publish": "tsx scripts/build-dataset.ts --publish",
    "export:zip": "tsx scripts/export-package.ts",
    "predev": "tsx scripts/prepare-public-data.ts",
    "data:public": "tsx scripts/prepare-public-data.ts",
    "serve": "node tests/e2e/static-server.mjs"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "next": "16.4.2",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
